          "label": "Theme typography style",
          "default": "auto",
          "options": [
            {
              "value": "auto",
              "label": "Automatic (use block style)"
            },
            {
              "value": "body",
              "label": "Body"
            },
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            },
            {
              "value": "h4",
              "label": "H4"
            },
            {
              "value": "h5",
              "label": "H5"
            },
            {
              "value": "h6",
